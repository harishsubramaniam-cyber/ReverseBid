# Copy to .env and edit. Every value is optional - the app runs with none of them.

# --- core
RA_SECRET_KEY=change-me-to-a-long-random-string
RA_BASE_URL=http://localhost:8000
RA_TIMEZONE=Asia/Kolkata
RA_CURRENCY=INR
RA_CURRENCY_SYMBOL=₹
# RA_DATABASE_URL=sqlite:///data/reverse_auction.db
# RA_DATABASE_URL=postgresql+psycopg://user:password@localhost/reversebid

# --- email
# Leave RA_SMTP_HOST empty and every message is saved to the in-app Outbox
# and to data/outbox/*.eml instead of being sent.
RA_SMTP_HOST=
RA_SMTP_PORT=587
RA_SMTP_USER=
RA_SMTP_PASSWORD=
RA_SMTP_STARTTLS=1
RA_SMTP_SSL=0
RA_MAIL_FROM=no-reply@example.com
RA_MAIL_FROM_NAME=ReverseBid

# --- engine timings
RA_SCHEDULER_INTERVAL=5
RA_ENDING_SOON_MINUTES=5
RA_STARTING_SOON_MINUTES=30

# --- behind a reverse proxy
# How many proxies sit in front of this app. 0 (the default, and right when you
# run it yourself) means X-Forwarded-For is ignored, because anyone can send it.
# Set 1 behind a single nginx or load balancer.
RA_TRUSTED_PROXIES=0
